# ============================================================
#  Georgia State Patrol portal — environment variables
#  Copy this file to .env.local for local testing, and add the
#  same values in your host's dashboard (e.g. Vercel → Settings
#  → Environment Variables) when you deploy.
# ============================================================

# The public URL of the site, no trailing slash.
# Local: http://localhost:3000   Live: https://your-site.vercel.app
PUBLIC_BASE_URL=http://localhost:3000

# Long random string used to sign login cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# ---------- Discord application (discord.com/developers/applications) ----------
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
# Developer Portal → General Information → Public Key (lets the site verify Accept/Deny button clicks)
DISCORD_PUBLIC_KEY=
# Right-click your server icon → Copy Server ID (Developer Mode must be on)
DISCORD_GUILD_ID=1558194098890874971

# ---------- Role IDs (right-click a role → Copy Role ID). Comma-separate multiple. ----------
# Supervisor, Patrol, Department Personnel -> employee portal access
ROLE_EMPLOYEE_IDS=1558194099268358282,1558194099268358274,1558194099197059241
# Office of the Colonel, High Command -> review applications + edit command staff / divisions
ROLE_COMMAND_STAFF_IDS=1558194099327074422,1558194099327074418
# Command -> review cadet applications
ROLE_APPLICATION_REVIEWER_IDS=1558194099297853566
# Professional Standards Bureau. The ONLY role that can see employee reports.
ROLE_PSB_IDS=1558194098995732496

# Roles pinged by the webhooks
APPLICATIONS_PING_ROLE_ID=1558194099327074418
REPORTS_PING_ROLE_ID=1558194098995732496

# ---------- Webhooks (keep these secret — anyone with the URL can post to the channel) ----------
APPLICATIONS_WEBHOOK_URL=
REPORTS_WEBHOOK_URL=

# ---------- Database ----------
# Leave empty to use a built-in local database stored in ./.data (fine for testing on your PC).
# For a live site, create a free Postgres database (neon.tech or supabase.com) and paste its URL here.
DATABASE_URL=

# Local preview only: lets you click through the portal as fake roles before Discord is set up.
# Ignored on a live (production) site.
DEV_LOGIN=false
